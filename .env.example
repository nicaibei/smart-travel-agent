# 高德地图服务
AMAP_WEB_KEY=replace-with-your-amap-web-key
AMAP_JS_KEY=replace-with-your-amap-js-key
AMAP_SECURITY_CODE=replace-with-your-amap-security-code

# 图片服务
UNSPLASH_ACCESS_KEY=replace-with-your-unsplash-access-key
UNSPLASH_SECRET_KEY=replace-with-your-unsplash-secret-key

# 大模型服务
LLM_API_KEY=replace-with-your-llm-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_ID=qwen-turbo
LLM_TIMEOUT=60

# 后端服务
HOST=127.0.0.1
PORT=8000
